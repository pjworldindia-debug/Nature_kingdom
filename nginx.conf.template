# /etc/nginx/sites-available/nature-kingdom
# Nature Kingdom runs on subdomain shop.yourdomain.com
# Existing website on the VPS is NOT affected

server {
    listen 80;
    server_name shop.yourdomain.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name shop.yourdomain.com;

    ssl_certificate     /etc/letsencrypt/live/shop.yourdomain.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shop.yourdomain.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling        on;
    ssl_stapling_verify on;
    resolver            8.8.8.8 8.8.4.4 valid=300s;

    # Security headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains; preload" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # ── Static assets (served by Nginx, bypass Node entirely) ──────────────────
    location /assets/ {
        root /var/www/nature-kingdom/public;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
        gzip_static on;
    }
    location /css/ {
        root /var/www/nature-kingdom/public;
        expires 7d;
        add_header Cache-Control "public";
    }
    location /js/ {
        root /var/www/nature-kingdom/public;
        expires 7d;
        add_header Cache-Control "public";
    }

    # ── Node App (Dynamic routes) ──────────────────────────────────────────────
    location / {
        proxy_pass http://127.0.0.1:2431;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
